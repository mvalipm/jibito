<?xml version="1.0" encoding="utf-8"?>
<!--
  ویجت «خرج امروز»، اندازه‌ی متوسط (۳×۲، ۴×۲). RemoteViews: فقط ویوهای ساده.
  بالا: جیبی، «امروز · دوشنبه ۲۰ مهر» و برچسب حال بودجه. وسط: خرج امروز درشت و مقایسه با یک روز معمولی، کنارش نمودار هفت روز.
  پایین: خرج ماه، یا با بودجه «چقدر مونده» و نوار ماه.
  اندازه‌های دیگر همین شناسه‌ها را (هر کدام بخشی‌شان را) دارند و SpendViews یکسان پرشان می‌کند.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <include layout="@layout/widget_spend_header" />

    <!-- جای خالی بین سرتیتر و عدد (وزن در ردیف عدد نمی‌آید تا وزن تودرتو نشود) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal">

        <include
            layout="@layout/widget_spend_today"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_chart"
            android:layout_width="112dp"
            android:layout_height="80dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/widget_chart_title"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <include layout="@layout/widget_spend_footer" />
</LinearLayout>
