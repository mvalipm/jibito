<?xml version="1.0" encoding="utf-8"?>
<!--
  ویجت «جیب امروز»، اندازه‌ی معمولی (RemoteViews؛ فقط ویوهای ساده مجازند). از بالا به پایین:
  سرتیتر: جیبی + «امروز» و تاریخ روز.
  وسط (همه‌ی جای خالی را می‌گیرد): خرج امروز درشت + یک خط راهنما (با بودجه: «امروز هنوز X جا داری» / «X بیشتر از سهم امروز»).
  پایین: نوار بودجه‌ی ماه، و زیرش «چقدر مونده» و درصد. بدون بودجه: فقط «این ماه X تومان».
  رنگ زمینه حال بودجه است (SpendWidget)؛ بدون بودجه، زمینه‌ی کرم.
  اندازه‌ی کوچک: widget_spend_small.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_mascot"
            android:layout_width="18dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_mascot_happy" />

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="start"
            android:maxLines="1"
            android:text="@string/widget_today"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/vazirmatn_regular"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_black"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/widget_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/vazirmatn_bold"
                android:maxLines="1"
                android:text="@string/unit_toman"
                android:textColor="@color/widget_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_medium"
            android:gravity="start"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- نوار بودجه‌ی ماه: پر شدنش از راست -->
    <ProgressBar
        android:id="@+id/widget_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginBottom="6dp"
        android:indeterminate="false"
        android:max="100"
        android:mirrorForRtl="true"
        android:progress="0"
        android:progressDrawable="@drawable/widget_bar"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="start"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/vazirmatn_black"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
