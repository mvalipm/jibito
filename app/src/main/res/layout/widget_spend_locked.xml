<?xml version="1.0" encoding="utf-8"?>
<!-- ویجت جیبیتو وقتی قفل اپ روشن است (همه‌ی اندازه‌ها): مبلغی نشان داده نمی‌شود -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="44dp"
        android:layout_marginBottom="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_mascot_happy" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn_black"
        android:maxLines="1"
        android:text="@string/widget_locked_title"
        android:textColor="@color/widget_text"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/vazirmatn_medium"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/widget_locked_hint"
        android:textColor="@color/widget_muted"
        android:textSize="13sp" />
</LinearLayout>
