<?xml version="1.0" encoding="utf-8"?>
<!--
  ویجت «خرج امروز»، اندازه‌ی کوچک (۲×۲، یا پهن و کوتاه): جیبی و «امروز»، عدد درشت و واحد زیرش،
  مقایسه‌ی کوتاه با روز معمولی، و پایین «این ماه …» یا نوار بودجه با «… مونده».
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/widget_mascot"
            android:layout_width="20dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_mascot_happy" />

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/vazirmatn_bold"
            android:maxLines="1"
            android:text="@string/widget_today"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_black"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/widget_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_bold"
            android:maxLines="1"
            android:text="@string/unit_toman"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_zero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_black"
            android:maxLines="2"
            android:text="@string/widget_zero"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_vs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_vs_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:fontFamily="@font/vazirmatn_bold"
                android:maxLines="1"
                android:textColor="@color/widget_accent"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_vs_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:fontFamily="@font/vazirmatn_bold"
                android:maxLines="1"
                android:textColor="@color/widget_calm"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_vs_rest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn_regular"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/widget_spend_progress" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_foot_lead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:fontFamily="@font/vazirmatn_regular"
            android:maxLines="1"
            android:text="@string/widget_this_month"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_foot_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_bold"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
