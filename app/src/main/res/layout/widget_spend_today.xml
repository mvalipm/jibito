<?xml version="1.0" encoding="utf-8"?>
<!--
  خرج امروز درشت («۸٫۵» + «میلیون تومان») و زیرش مقایسه با یک روز معمولی («۱٫۷ برابر» + «یک روز معمولی»).
  امروز هنوز خرجی نشده ← به‌جای «۰ تومان» جمله‌ی widget_zero.
  رنگ‌ها از منابع‌اند (روشن/تیره را لانچر انتخاب می‌کند)، پس «بیشتر» و «کمتر» هر کدام TextView خودشان را دارند.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_num_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_black"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="38sp" />

        <TextView
            android:id="@+id/widget_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/vazirmatn_bold"
            android:maxLines="1"
            android:text="@string/unit_toman"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_zero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn_black"
        android:maxLines="2"
        android:text="@string/widget_zero"
        android:textColor="@color/widget_text"
        android:textSize="18sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_vs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_vs_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:fontFamily="@font/vazirmatn_bold"
            android:maxLines="1"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_vs_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:fontFamily="@font/vazirmatn_bold"
            android:maxLines="1"
            android:textColor="@color/widget_calm"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_vs_rest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_regular"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
