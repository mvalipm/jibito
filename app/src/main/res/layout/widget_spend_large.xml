<?xml version="1.0" encoding="utf-8"?>
<!--
  ویجت جیبیتو، اندازه‌ی بزرگ (۴×۳ و بزرگ‌تر). از بالا:
  سرتیتر (جیبی، «جیبیتو»، تاریخ) / عنوان عدد اصلی («امروز می‌تونی خرج کنی» …) / عدد درشت + واحد /
  برچسب «خرج امروز» / نمودار هفت روز اخیر (تصویر، SpendWidgetArt) / نوار ماه با نشانگر زمان (تصویر) + «X مونده» و درصد.
  بدون بودجه: جای نوار، دکمه‌ی «بودجه بذار». همه‌ی شناسه‌ها با طرح‌های دیگر یکی است (SpendWidget).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_mascot"
            android:layout_width="20dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_mascot_happy" />

        <TextView
            android:id="@+id/widget_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="start"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_medium"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/vazirmatn_medium"
        android:gravity="start"
        android:maxLines="1"
        android:textColor="@color/widget_muted"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_black"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/widget_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_bold"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_chip_on"
        android:fontFamily="@font/vazirmatn_bold"
        android:maxLines="1"
        android:paddingStart="11dp"
        android:paddingTop="2dp"
        android:paddingEnd="11dp"
        android:paddingBottom="2dp"
        android:textColor="@color/widget_text"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_chart_cap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/vazirmatn_bold"
                android:gravity="start"
                android:maxLines="1"
                android:text="@string/widget_week"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_chart_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_medium"
                android:maxLines="1"
                android:text="@string/widget_week_share"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_chart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_chart_cd"
            android:scaleType="fitXY" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_bar"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="10dp"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="start"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/vazirmatn_medium"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_cta"
        android:fontFamily="@font/vazirmatn_bold"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="@string/widget_set_budget"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
