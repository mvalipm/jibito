<?xml version="1.0" encoding="utf-8"?>
<!-- جمع موجودی کارت‌های همین ویجت: «۴۲٫۶» درشت و «میلیون تومان، جمع ۳ کارت» کنارش -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:baselineAligned="true"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/widget_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn_black"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/widget_total_unit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/vazirmatn_bold"
        android:maxLines="1"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
</LinearLayout>
