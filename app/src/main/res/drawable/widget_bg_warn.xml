<?xml version="1.0" encoding="utf-8"?>
<!-- ویجت وقتی بودجه هست: رنگ «حال جیب» (مثل بالای صفحه‌ی خلاصه)، با نور ملایم از گوشه‌ی بالا -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_mood_warn" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="250"
                android:endColor="#00FFFFFF"
                android:startColor="#24FFFFFF"
                android:type="linear" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
