<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- خواندن پیامک‌های بانکی -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- باخبر شدن از رسیدن پیامک تازه، حتی وقتی اپ بسته است -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- نوتیفیکیشن «این خرج مال چی بود؟» (اندروید ۱۳ به بعد) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- قفل اپ با اثر انگشت / چهره / قفل گوشی (اجازه‌ی عادی؛ بدون پرسیدن از کاربر داده می‌شود) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!--
      allowBackup=false: پشتیبان ابری گوگل خاموش (اندروید ۱۱ و قبل‌تر هیچ پشتیبان خودکاری ندارند).
      از اندروید ۱۲، انتقال گوشی به گوشی با data_extraction_rules تنظیم می‌شود. پشتیبان اصلی: فایل رمزدار از تنظیمات اپ.
      fullBackupContent=false همان رفتار allowBackup=false را برای اندروید ۱۱ و قبل‌تر صریح می‌کند.
    -->
    <application
        android:name=".JibitoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jibito">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- پیامک تازه -->
        <receiver
            android:name=".data.sms.SmsReceivedReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- ویجت صفحه‌ی اصلی: خرج امروز و باقی‌مانده‌ی بودجه -->
        <receiver
            android:name=".widget.SpendWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_spend_info" />
        </receiver>

        <!-- دکمه‌های دسته در نوتیفیکیشن -->
        <receiver
            android:name=".notify.CategoryActionReceiver"
            android:exported="false" />
    </application>

</manifest>
